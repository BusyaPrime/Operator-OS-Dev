GOOGLE_CLOUD_PROJECT=operator-os-dev
GOOGLE_CLOUD_REGION=europe-west4
FIREBASE_PROJECT_ID=operator-os-dev
VERTEX_LOCATION=europe-west4
VERTEX_MODEL=gemini-2.5-flash
BIGQUERY_DATASET=ops_analytics
CLOUD_TASKS_LOCATION=europe-west1

# API
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
API_SERVICE_NAME=operator-os-api
READINESS_STRICT=false
TASKS_TARGET_BASE_URL=
AGENT_AUDIENCE=

# Desktop agent
AGENT_ID=local-desktop-agent
DEVICE_ID=local-device
DEVICE_NAME=Local Workstation
DEVICE_PLATFORM=windows
API_BASE_URL=http://localhost:8080
API_REQUEST_TIMEOUT_MS=10000
HEARTBEAT_INTERVAL_MS=30000
COMMAND_POLL_INTERVAL_MS=15000
SESSION_POLL_INTERVAL_MS=15000
ENABLE_COMMAND_EXECUTION=false
CONTROLLED_FALLBACK=true

# Mobile
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
EXPO_PUBLIC_USE_MOCKS=true
EXPO_PUBLIC_API_TIMEOUT_MS=10000
EXPO_PUBLIC_CONTROLLED_FALLBACK=true
EXPO_PUBLIC_AUTH_MODE=bootstrap-fallback

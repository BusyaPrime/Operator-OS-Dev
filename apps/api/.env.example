NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
API_SERVICE_NAME=operator-os-api
GOOGLE_CLOUD_PROJECT=operator-os-dev
VERTEX_LOCATION=europe-west4
VERTEX_MODEL=gemini-2.5-flash
FIRESTORE_DATABASE=(default)
COMMANDS_QUEUE=commands
APPROVALS_QUEUE=approvals
EXPORTS_QUEUE=exports
AGENT_EVENTS_TOPIC=agent-events
BUDGET_EVENTS_TOPIC=budget-events
OPERATOR_ALERTS_TOPIC=operator-alerts
SESSION_EVENTS_TOPIC=session-events
ARTIFACTS_BUCKET=operator-os-dev-artifacts
EXPORTS_BUCKET=operator-os-dev-exports
REMOTE_BUCKET=operator-os-dev-remote
OPERATOR_JWT_SECRET_NAME=operator-jwt-secret
SESSION_SIGNING_SECRET_NAME=session-signing-secret
READINESS_STRICT=false

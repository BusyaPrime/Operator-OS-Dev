NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
API_SERVICE_NAME=operator-os-api
GOOGLE_CLOUD_PROJECT=operator-os-dev
GOOGLE_CLOUD_REGION=europe-west4
FIREBASE_PROJECT_ID=operator-os-dev
VERTEX_LOCATION=europe-west4
VERTEX_MODEL=gemini-2.5-flash
FIRESTORE_DATABASE=(default)
FIRESTORE_DEVICE_STATES_COLLECTION=deviceStates
FIRESTORE_OPERATOR_STATES_COLLECTION=operatorStates
FIRESTORE_SESSIONS_COLLECTION=sessions
FIRESTORE_ALERTS_COLLECTION=alerts
FIRESTORE_COST_SNAPSHOTS_COLLECTION=costSnapshots
FIRESTORE_AUDIT_EVENTS_COLLECTION=auditEvents
CLOUD_TASKS_LOCATION=europe-west1
COMMANDS_QUEUE=commands
APPROVALS_QUEUE=approvals
EXPORTS_QUEUE=exports
TASKS_TARGET_BASE_URL=
AGENT_EVENTS_TOPIC=agent-events
BUDGET_EVENTS_TOPIC=budget-events
OPERATOR_ALERTS_TOPIC=operator-alerts
SESSION_EVENTS_TOPIC=session-events
BIGQUERY_DATASET=ops_analytics
# Phase 4.0 TD-057 — agent auth audit pipeline (ADR-025 D1)
# AGENT_AUDIT_BACKEND: bigquery (default in prod) | logging | noop
AGENT_AUDIT_BACKEND=bigquery
AGENT_AUDIT_DATASET=operator_os_dev_audit
AGENT_AUDIT_TABLE=agent_auth
ARTIFACTS_BUCKET=operator-os-dev-artifacts
EXPORTS_BUCKET=operator-os-dev-exports
REMOTE_BUCKET=operator-os-dev-remote
ARTIFACT_REGISTRY_REPOSITORY=operator-os-docker
CLOUD_RUN_SERVICE_NAME=operator-os-api
CLOUD_RUN_SERVICE_ACCOUNT=cloudrun-runtime@operator-os-dev.iam.gserviceaccount.com
OPERATOR_JWT_SECRET_NAME=operator-jwt-secret
SESSION_SIGNING_SECRET_NAME=session-signing-secret
GITHUB_TOKEN_SECRET_NAME=github-token
READINESS_STRICT=false

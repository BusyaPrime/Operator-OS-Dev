NODE_ENV=development
LOG_LEVEL=info
AGENT_ID=local-desktop-agent
DEVICE_ID=local-device
DEVICE_NAME=Local Workstation
DEVICE_PLATFORM=windows
API_BASE_URL=http://localhost:8080
HEARTBEAT_INTERVAL_MS=30000
COMMAND_POLL_INTERVAL_MS=15000
SESSION_POLL_INTERVAL_MS=15000
ENABLE_COMMAND_EXECUTION=false
EXPORTS_BUCKET=operator-os-dev-exports
REMOTE_BUCKET=operator-os-dev-remote
NOTIFIER_TOPIC=operator-alerts

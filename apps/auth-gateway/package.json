{
  "name": "@operator-os/auth-gateway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "dependencies": {
    "@google-cloud/firestore": "^8.5.0",
    "@google-cloud/secret-manager": "^6.1.1",
    "@operator-os/config": "workspace:*",
    "@operator-os/contracts": "workspace:*",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "firebase-admin": "^13.8.0",
    "google-auth-library": "^10.4.0",
    "jose": "^5.10.0",
    "zod": "^4.1.12"
  },
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.json",
    "dev": "pnpm exec tsx watch src/server.ts",
    "lint": "pnpm exec eslint \"src/**/*.ts\" --ignore-pattern \"src/**/*.test.ts\"",
    "start": "node dist/server.js",
    "test": "pnpm exec vitest run",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit"
  }
}

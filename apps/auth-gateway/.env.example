NODE_ENV=development
HOST=0.0.0.0
PORT=8081
LOG_LEVEL=info
AUTH_GATEWAY_SERVICE_NAME=operator-auth-gateway
GOOGLE_CLOUD_PROJECT=operator-os-dev
FIREBASE_PROJECT_ID=operator-os-dev

# Access token (JWT) issuance
AUTH_ACCESS_TOKEN_ISSUER=operator-auth-gateway
AUTH_ACCESS_TOKEN_AUDIENCE=operator-os-api
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Shared signing secret (Secret Manager resource name at runtime)
AUTH_JWT_SIGNING_SECRET_NAME=operator-jwt-secret

# Google OAuth client IDs accepted on /v1/auth/signin (comma-separated)
AUTH_ACCEPTED_GOOGLE_CLIENT_IDS=

# Firestore collections
FIRESTORE_USERS_COLLECTION=users
FIRESTORE_REFRESH_TOKENS_COLLECTION=refreshTokens

READINESS_STRICT=false
